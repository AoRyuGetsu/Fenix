{
    "name": "analitica/api",
    "description": "API de análisis de datos",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "nikic/fast-route": "^1.3",
        "monolog/monolog": "^3.7",
        "vlucas/phpdotenv": "^5.6",
        "php-di/php-di": "^7.0",
        "doctrine/orm": "^3.3",
        "symfony/validator": "^7.1",
        "lcobucci/jwt": "^5.3",
        "symfony/error-handler": "^7.1",
        "symfony/http-foundation": "^7.1",
        "symfony/cache": "^7.4",
        "zircote/swagger-php": "^6.2",
        "lcobucci/clock": "^3.3",
        "markrogoyski/math-php": "^2.13"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/router.php",
        "test": "phpunit",
        "openapi": "php -r 'require \"vendor/autoload.php\"; file_put_contents(\"public/openapi.json\", (new OpenApi\\Generator)->generate([\"app\"])->toJson()); echo \"openapi.json generated\\n\";'"
    }
}
